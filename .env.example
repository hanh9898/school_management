# Django settings
# Chế độ debug (True cho môi trường phát triển, False cho môi trường sản xuất)
DEBUG=True
# Khóa bí mật Django (nên tạo một khóa ngẫu nhiên mới cho mỗi môi trường)
# Có thể tạo bằng lệnh: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here
# Danh sách các host được phép truy cập
ALLOWED_HOSTS=localhost,127.0.0.1

# Database settings
DB_ENGINE=django.db.backends.postgresql
DB_NAME=school_management
# Thông tin đăng nhập cơ sở dữ liệu (nên sử dụng giá trị khác nhau cho mỗi môi trường)
DB_USER=school_dev_user
DB_PASSWORD=strong_dev_password_example
DB_HOST=db
DB_PORT=5432

# Email settings
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Môi trường (dev hoặc prod)
ENVIRONMENT=dev
